<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\WorldEngine.Core\WorldEngine.Core.csproj" />
    <ProjectReference Include="..\WorldEngine.Store\WorldEngine.Store.csproj" />
    <ProjectReference Include="..\WorldEngine.Contract\WorldEngine.Contract.csproj" />
  </ItemGroup>

  <!-- The shipped template set, the one TypeScript reads from templates/: a catalog or an init without a world uses it. -->
  <ItemGroup>
    <None Include="../../../templates/*.json" Link="templates/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
