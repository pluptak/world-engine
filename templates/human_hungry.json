{
  "id": "human_hungry",
  "extends": "human",
  "props": { "hunger": 0, "starvation": 0, "hunger_every": 10 },
  "fields": {
    "hunger_every": { "tier": "definition", "type": "integer" },
    "starvation": { "tier": "state", "type": "integer" }
  },
  "processes": [
    {
      "id": "hunger",
      "every_ticks": 10,
      "every_ticks_prop": "hunger_every",
      "effect": { "adjust_prop": { "prop": "hunger", "by": 1, "max": 100 } }
    },
    {
      "id": "starve",
      "every_ticks": 5,
      "while": { "prop": "hunger", "op": "gte", "value": 100 },
      "effect": { "adjust_prop": { "prop": "starvation", "by": 1, "max": 20 } },
      "then": { "damage": { "amount": 100 } }
    },
    {
      "id": "recover",
      "every_ticks": 5,
      "while": { "prop": "hunger", "op": "lt", "value": 100 },
      "effect": { "adjust_prop": { "prop": "starvation", "by": -1, "min": 0 } }
    }
  ]
}
