<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\WorldEngine.Core\WorldEngine.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="9.4.1" />
  </ItemGroup>

  <!-- The contract as TypeScript defines it (scratchpad/gen/contract-bundle.mjs): the requests, responses, scenarios and coverage. -->
  <ItemGroup>
    <EmbeddedResource Include="Schema/contract.json" LogicalName="contract.json" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
